# Variables à définir sur le service API Railway (Settings → Variables).
# Ne committez jamais de secrets réels.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL Railway — coller la connection string du plugin Postgres
# Format Npgsql, exemple :
# Host=xxx.railway.app;Port=5432;Database=railway;Username=postgres;Password=***;SSL Mode=Require;Trust Server Certificate=true
Database__Provider=PostgreSql
Database__ConnectionString=

# Secrets de production (générer des valeurs longues et aléatoires)
Jwt__Secret=
Jwt__Issuer=SecureFileStorage
Jwt__Audience=SecureFileStorageClients
Jwt__ExpirationMinutes=60

Encryption__MasterKey=

# Stockage fichiers (volume Railway monté sur /app/storage)
Storage__Provider=LocalFileSystem
Storage__BasePath=/app/storage

# ClamAV optionnel (laisser false sauf service ClamAV dédié)
Antivirus__Enabled=false

# Chatbot optionnel
Chatbot__Enabled=false
Chatbot__ApiKey=
